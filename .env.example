# =====================================================
# Variables de Entorno - Ejemplo
# Programa Didáctico Musical 2026/2027
# =====================================================

# Este proyecto NO requiere variables de entorno
# Es 100% cliente y funciona sin backend

# Si en el futuro necesitas añadir alguna:

# Ejemplo: API Key para servicio externo (opcional)
# VITE_API_KEY=tu_api_key_aqui

# Ejemplo: URL de API (opcional)
# VITE_API_URL=https://api.ejemplo.com

# Ejemplo: Modo de la aplicación (opcional)
# VITE_APP_MODE=production

# Nota: Las variables deben empezar con VITE_ para ser accesibles
# desde el código frontend (import.meta.env.VITE_NOMBRE_VARIABLE)
